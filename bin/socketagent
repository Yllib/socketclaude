#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  SCRIPT_PATH="$(readlink -f "$SCRIPT_PATH" 2>/dev/null || echo "$SCRIPT_PATH")"
fi

REPO_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
SERVER_DIR="$REPO_ROOT/server"
SERVICE_CONTROL="$SERVER_DIR/scripts/service-control.sh"

if ! command -v node >/dev/null 2>&1; then
  MANAGED_NODE_DIR="${SOCKETAGENT_NODE_DIR:-$HOME/.local/share/socketagent/node}/bin"
  if [[ -x "$MANAGED_NODE_DIR/node" ]]; then
    export PATH="$MANAGED_NODE_DIR:$PATH"
  fi
fi

MANAGED_BACKEND_BIN="${SOCKET_AGENT_NPM_PREFIX:-${SOCKETAGENT_NPM_PREFIX:-$HOME/.socket-agent/toolchains/npm-global}}/bin"
if [[ -d "$MANAGED_BACKEND_BIN" ]]; then
  export PATH="$MANAGED_BACKEND_BIN:$PATH"
fi

usage() {
  cat <<EOF
SocketAgent command line

Usage:
  socketagent pair [--raw]        Show pairing QR or raw pairing payload
  socketagent direct [--json]     Show direct/manual IP connection settings
  socketagent token               Show direct/manual auth token only
  socketagent install [args...]   Re-run the SocketAgent installer
  socketagent status              Show server service status
  socketagent start               Start the server service
  socketagent stop                Stop the server service
  socketagent logs                Follow server logs
  socketagent restart             Restart server using the safe restart script
  socketagent macos-permissions   Open macOS file-access settings and reveal helper
  socketagent doctor              Print basic install diagnostics
  socketagent help                Show this help
EOF
}

cmd="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi

case "$cmd" in
  pair|qr)
    exec node "$SERVER_DIR/scripts/show-pairing.js" "$@"
    ;;
  direct|manual)
    exec node "$SERVER_DIR/scripts/show-direct-auth.js" "$@"
    ;;
  token|auth-token|authtoken)
    exec node "$SERVER_DIR/scripts/show-direct-auth.js" --raw
    ;;
  install|setup)
    exec "$REPO_ROOT/install-server.sh" "$@"
    ;;
  status)
    exec "$SERVICE_CONTROL" status "$@"
    ;;
  start)
    exec "$SERVICE_CONTROL" start "$@"
    ;;
  stop)
    exec "$SERVICE_CONTROL" stop "$@"
    ;;
  logs)
    exec "$SERVICE_CONTROL" logs "$@"
    ;;
  restart)
    exec "$SERVER_DIR/scripts/restart-server.sh" "$@"
    ;;
  macos-permissions|permissions)
    if [[ "$(uname -s)" != "Darwin" ]]; then
      echo "This command is only available on macOS." >&2
      exit 1
    fi
    "$SERVER_DIR/scripts/install-macos-helper.sh"
    HELPER_APP="${SOCKETAGENT_MACOS_HELPER_APP:-$HOME/Applications/SocketAgent Server.app}"
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles"
    open -R "$HELPER_APP"
    echo "Opened Full Disk Access settings and revealed:"
    echo "  $HELPER_APP"
    ;;
  doctor)
    echo "SocketAgent diagnostics"
    echo "Repo: $REPO_ROOT"
    echo "Server: $SERVER_DIR"
    echo "Node: $(command -v node || echo 'not found')"
    if command -v node >/dev/null 2>&1; then echo "Node version: $(node --version)"; fi
    echo "Claude CLI: $(command -v claude || echo 'not found')"
    echo "Codex CLI: $(command -v codex || echo 'not found')"
    echo "Platform: $(uname -s)"
    echo "Service: $("$SERVICE_CONTROL" name)"
    "$SERVICE_CONTROL" is-active >/dev/null 2>&1 \
      && echo "Service status: active" \
      || echo "Service status: not active"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "" >&2
    usage >&2
    exit 2
    ;;
esac
